
#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    if (r <= 0 || c <= 0)
        return 0;

    long long a[r][c];

    // Input matrix
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%lld", &a[i][j]);
        }
    }

    int found = 0;

    // Check each cell in row-major order
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {

            int minRow = 1;
            int maxCol = 1;

            // Check whether minimum in its row
            for (int k = 0; k < c; k++) {
                if (a[i][k] < a[i][j]) {
                    minRow = 0;
                    break;
                }
            }

            // Check whether maximum in its column
            for (int k = 0; k < r; k++) {
                if (a[k][j] > a[i][j]) {
                    maxCol = 0;
                    break;
                }
            }

            if (minRow && maxCol) {
                printf("%d %d %lld\n", i, j, a[i][j]);
                found = 1;
                break;
            }
        }

        if (found)
            break;
    }

    if (!found)
        printf("None\n");

    return 0;
}
