
#include <stdio.h>

int digitSum(long long num) {
    int sum = 0;

    while (num > 0) {
        sum += num % 10;
        num /= 10;
    }

    return sum;
}

int main() {
    int n;
    scanf("%d", &n);

    if (n < 0)
        return 0;

    long long arr[n > 0 ? n : 1];

    for (int i = 0; i < n; i++) {
        scanf("%lld", &arr[i]);
    }

    long long count = 0;

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (digitSum(arr[i]) == digitSum(arr[j])) {
                count++;
            }
        }
    }

    printf("%lld\n", count);

    return 0;
}
