
#include <stdio.h>

long long gcd(long long a, long long b) {
    while (b != 0) {
        long long temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    long long n, m;
    scanf("%lld %lld", &n, &m);

    if (n < 0) n = -n;

    if (n == 0 || m <= 0) {
        printf("0\n");
        return 0;
    }

    long long count = 0;

    for (long long x = 1; x <= m; x++) {
        if (gcd(x, n) == 1) {
            count++;
        }
    }

    printf("%lld\n", count);

    return 0;
}
