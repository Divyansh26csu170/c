
#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    if (r <= 0 || c <= 0) {
        printf("0\n");
        return 0;
    }

    long long a[r][c];

    // Input matrix
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%lld", &a[i][j]);
        }
    }

    int count = 0;

    // Check every cell
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {

            int peak = 1;

            // Check upper neighbour
            if (i > 0 && a[i][j] <= a[i-1][j])
                peak = 0;

            // Check lower neighbour
            if (i < r-1 && a[i][j] <= a[i+1][j])
                peak = 0;

            // Check left neighbour
            if (j > 0 && a[i][j] <= a[i][j-1])
                peak = 0;

            // Check right neighbour
            if (j < c-1 && a[i][j] <= a[i][j+1])
                peak = 0;

            if (peak)
                count++;
        }
    }

    printf("%d\n", count);

    return 0;
}
