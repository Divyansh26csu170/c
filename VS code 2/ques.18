
#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    if (n <= 0)
        return 0;

    long long a[n][n];
    int symmetric = 1;

    // Input matrix
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%lld", &a[i][j]);
        }
    }

    // Check symmetry
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (a[i][j] != a[j][i]) {
                symmetric = 0;
                break;
            }
        }
    }

    if (symmetric)
        printf("YES\n");
    else
        printf("NO\n");

    return 0;
}
