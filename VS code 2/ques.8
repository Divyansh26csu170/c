
#include <stdio.h>

int main() {
    int n;
    long long target;

    scanf("%d %lld", &n, &target);

    if (n < 0) {
        return 0;
    }

    long long arr[n > 0 ? n : 1];
    
    for (int i = 0; i < n; i++) {
        scanf("%lld", &arr[i]);
    }

    long long count = 0;

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] + arr[j] == target) {
                count++;
            }
        }
    }

    printf("%lld\n", count);

    return 0;
}
