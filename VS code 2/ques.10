
#include <stdio.h>

int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    if (n < 0)
        n = -n;

    if (n == 0 || m <= 0) {
        printf("0\n");
        return 0;
    }

    int count = 0;

    for (int x = 1; x <= m; x++) {
        if (gcd(x, n) == 1) {
            count++;
        }
    }

    printf("%d\n", count);

    return 0;
}
