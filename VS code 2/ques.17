
#include <stdio.h>

int main() {
    int r, c;
    scanf("%d %d", &r, &c);

    if (r <= 0 || c <= 0)
        return 0;

    long long a[r][c];

    // Input matrix
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%lld", &a[i][j]);
        }
    }

    // Calculate row sums
    for (int i = 0; i < r; i++) {
        long long sum = 0;

        for (int j = 0; j < c; j++) {
            sum += a[i][j];
        }

        printf("%lld ", sum);
    }

    printf("\n");

    // Calculate column sums
    for (int j = 0; j < c; j++) {
        long long sum = 0;

        for (int i = 0; i < r; i++) {
            sum += a[i][j];
        }

        printf("%lld ", sum);
    }

    printf("\n");

    return 0;
}
