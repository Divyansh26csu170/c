
#include <stdio.h>
#include <ctype.h>

int main() {
    char str[1000];

    fgets(str, sizeof(str), stdin);

    int vowels = 0, consonants = 0;
    int digits = 0, spaces = 0;

    for (int i = 0; str[i] != '\0'; i++) {
        char ch = tolower((unsigned char)str[i]);

        if (ch >= 'a' && ch <= 'z') {
            if (ch == 'a' || ch == 'e' || ch == 'i' ||
                ch == 'o' || ch == 'u') {
                vowels++;
            } else {
                consonants++;
            }
        }
        else if (isdigit((unsigned char)ch)) {
            digits++;
        }
        else if (ch == ' ') {
            spaces++;
        }
    }

    printf("%d %d %d %d\n",
           vowels, consonants, digits, spaces);

    return 0;
}
